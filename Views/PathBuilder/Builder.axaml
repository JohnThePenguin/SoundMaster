<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SoundMasterGui.Views.PathBuilder"
             xmlns:vm="clr-namespace:SoundMasterGui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SoundMasterGui.Views.PathBuilder.Builder"
             x:DataType="vm:PathBuilderViewModel"
             >
    
    <ScrollViewer 
        Height="720" 
        Width="1024"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        >
        
        <StackPanel 
            HorizontalAlignment="Left" 
            VerticalAlignment="Stretch"
            Orientation="Vertical"
        >
            <Grid x:Name="TimeGrid" Height="20" HorizontalAlignment="Stretch" Background="GhostWhite"></Grid>
            <Canvas IsHitTestVisible="False">
                <Line 
                    StartPoint="{Binding StartPoint}"
                    EndPoint="{Binding EndPoint}" 
                    Stroke="Purple" 
                    StrokeThickness="3"
                />
            </Canvas>
            <controls:MainGrid Columns="40" Height="700" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer> 
    
</UserControl>
